# Server Configuration
PORT=3000

# Application Configuration
# Time in hours before the application automatically shuts down
SHUTDOWN_TIME_HOURS=3

# Logging Configuration
# Log level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# CORS Configuration
# Allowed origin for CORS requests (use * for all origins, or specific URL)
CORS_ORIGIN=http://localhost:3000
